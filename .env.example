# Copy to .env and fill in. Never commit .env.

# --- Claude API (set identification + condition assessment) ---
ANTHROPIC_API_KEY=

# --- Rebrickable (free key: https://rebrickable.com/api/) ---
REBRICKABLE_API_KEY=

# --- BrickLink Price Guide (register: https://www.bricklink.com/v2/api/register_consumer.page) ---
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=

# --- Email intake (Source D). For Gmail use an App Password, never your real password. ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=lego.alerts@example.com
IMAP_PASSWORD=

# --- Alerts ---
# ntfy: pick a hard-to-guess topic name, subscribe to it in the ntfy app.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Telegram (optional): create a bot via @BotFather, get your chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- eBay Browse API (optional Source C: https://developer.ebay.com) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
